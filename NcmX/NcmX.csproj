<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NcmX</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.2.0</Version>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- PRI/XAML publishing is required even though this app is unpackaged. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <AppxPackage>false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NCM_X</AssemblyName>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>
  <Target Name="PublishAppXamlResources" AfterTargets="Publish" BeforeTargets="VerifyPublishedAppResources">
    <Copy SourceFiles="$(TargetDir)$(ProjectPriFileName)" DestinationFolder="$(PublishDir)"
          Condition="Exists('$(TargetDir)$(ProjectPriFileName)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <AppXamlBinary Include="$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(AppXamlBinary)" DestinationFiles="@(AppXamlBinary->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="VerifyPublishedAppResources" AfterTargets="Publish" DependsOnTargets="PublishAppXamlResources">
    <Error Condition="!Exists('$(PublishDir)resources.pri')"
           Text="App resources.pri was not published. The resulting app cannot load App.xaml. Do not distribute this output." />
  </Target>
</Project>
